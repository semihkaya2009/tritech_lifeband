rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminUserDoc() {
      return /databases/$(database)/documents/adminUsers/$(request.auth.uid);
    }

    function isSystemAdmin() {
      return signedIn()
        && (
          request.auth.token.systemAdmin == true
          || exists(adminUserDoc())
        );
    }

    function ownsUserDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function staffDoc() {
      return /databases/$(database)/documents/medicalStaff/$(request.auth.uid);
    }

    function isApprovedStaff() {
      return signedIn()
        && exists(staffDoc())
        && get(staffDoc()).data.status == 'approved';
    }

    function qrDoc(qrId) {
      return /databases/$(database)/documents/qrCodes/$(qrId);
    }

    function ownsQr(qr) {
      return signedIn() && qr.data.ownerUid == request.auth.uid;
    }

    function claimEmailMatchesAuth(qr) {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email == qr.data.claimEmail;
    }

    function canReadQr(qr) {
      return isSystemAdmin()
        || isApprovedStaff()
        || ownsQr(qr)
        || (
          qr.data.status == 'claimed'
          && claimEmailMatchesAuth(qr)
        );
    }

    function canGetQr(qr) {
      return canReadQr(qr)
        || qr.data.status == 'unclaimed';
    }

    function ownsQrId(qrId) {
      return signedIn()
        && exists(qrDoc(qrId))
        && get(qrDoc(qrId)).data.ownerUid == request.auth.uid;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validAdminQrCreate() {
      return isSystemAdmin()
        && request.resource.data.status == 'unclaimed'
        && request.resource.data.tokenHash is string
        && request.resource.data.createdAt is timestamp
        && !request.resource.data.keys().hasAny([
          'ownerUid',
          'claimEmail',
          'claimPhone',
          'claimUid',
          'claimedAt'
        ]);
    }

    function validQrClaim() {
      return signedIn()
        && resource.data.status == 'unclaimed'
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimUid == request.auth.uid
        && changedOnly(['status', 'claimEmail', 'claimPhone', 'claimUid', 'claimedAt'])
        && request.resource.data.claimEmail is string
        && request.resource.data.claimPhone is string
        && request.resource.data.claimedAt is timestamp;
    }

    function validQrAttach() {
      return signedIn()
        && resource.data.status == 'claimed'
        && request.auth.token.email == resource.data.claimEmail
        && request.resource.data.status == 'active'
        && request.resource.data.ownerUid == request.auth.uid
        && changedOnly(['status', 'ownerUid', 'activatedAt'])
        && request.resource.data.activatedAt is timestamp;
    }

    function validQrRevoke() {
      return (isSystemAdmin() || ownsQr(resource))
        && resource.data.status in ['claimed', 'active']
        && request.resource.data.status == 'revoked'
        && changedOnly(['status', 'revokedAt'])
        && request.resource.data.revokedAt is timestamp;
    }

    function validClaimPublicProfileCreate(qrId) {
      return signedIn()
        && exists(qrDoc(qrId))
        && get(qrDoc(qrId)).data.status == 'claimed'
        && get(qrDoc(qrId)).data.claimUid == request.auth.uid
        && request.resource.data.qrId == qrId
        && request.resource.data.claimUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'qrId',
          'claimUid',
          'status',
          'displayFields',
          'visibility',
          'createdAt',
          'updatedAt'
        ]);
    }

    match /adminUsers/{uid} {
      allow get: if ownsUserDoc(uid) || isSystemAdmin();
      allow list: if isSystemAdmin();
      allow write: if isSystemAdmin();
    }

    match /users/{uid} {
      allow read, write: if ownsUserDoc(uid) || isSystemAdmin();
    }

    match /profiles/{uid} {
      allow read, write: if ownsUserDoc(uid) || isSystemAdmin();
    }

    match /visibilitySettings/{uid} {
      allow read, write: if ownsUserDoc(uid) || isSystemAdmin();
    }

    match /publicProfiles/{qrId} {
      allow read: if true;
      allow create: if isSystemAdmin()
        || validClaimPublicProfileCreate(qrId)
        || (
          ownsQrId(qrId)
          && request.resource.data.ownerUid == request.auth.uid
        );
      allow update: if isSystemAdmin()
        || (
          ownsQrId(qrId)
          && request.resource.data.ownerUid == request.auth.uid
        );
      allow delete: if isSystemAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
        );
    }

    match /qrCodes/{qrId} {
      allow get: if canGetQr(resource);
      allow list: if canReadQr(resource);
      allow create: if validAdminQrCreate();
      allow update: if validQrClaim()
        || validQrAttach()
        || validQrRevoke();
      allow delete: if isSystemAdmin();
    }

    match /staffApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isSystemAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isSystemAdmin();
    }

    match /medicalStaff/{uid} {
      allow read: if isSystemAdmin() || ownsUserDoc(uid);
      allow write: if isSystemAdmin();
    }

    match /accessLogs/{logId} {
      allow create: if request.resource.data.keys().hasOnly([
        'qrId',
        'mode',
        'createdAt',
        'userAgent'
      ])
      && request.resource.data.qrId is string
      && request.resource.data.mode in ['public', 'staff', 'admin'];
      allow read: if isSystemAdmin();
      allow update, delete: if false;
    }

    match /adminSettings/{document=**} {
      allow read, write: if isSystemAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
